// Prisma Schema for Tresaurio Trading Platform

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH MODELS ====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Hashed password (null for OAuth users)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  dashboard     UserDashboard?
  templates     DashboardTemplate[]
  favorites     UserFavorite[]
  
    activityLogs  UserActivityLog[]
}
model UserActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== TRADING MODELS ====================

// API Keys for exchange connections
model ApiKey {
  id            String   @id @default(cuid())
  userId        String
  exchange      String   // binance, okx, bybit, coinbase
  label         String?  // User-defined label (e.g., "Main Account", "Trading Bot")
  apiKey        String   // Encrypted API key
  apiSecret     String   // Encrypted API secret
  passphrase    String?  // Encrypted passphrase (required for OKX, Coinbase)
  permissions   String[] // ["spot", "futures", "withdraw"]
  isTestnet     Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, label])
  @@index([userId])
  @@index([exchange])
  @@index([isActive])
}

// Trade history (synced from exchanges)
model Trade {
  id            String   @id @default(cuid())
  exchange      String
  symbol        String   // BTCUSDT
  side          String   // buy, sell
  type          String   // market, limit
  quantity      Float
  price         Float
  quoteQty      Float    // Total cost/value
  commission    Float?
  commissionAsset String?
  orderId       String
  tradeId       String?
  isMaker       Boolean  @default(false)
  executedAt    DateTime
  createdAt     DateTime @default(now())

  @@unique([exchange, orderId])
  @@index([exchange, symbol])
  @@index([executedAt])
}

// Open orders (synced from exchanges)
model Order {
  id            String   @id @default(cuid())
  exchange      String
  symbol        String
  orderId       String
  clientOrderId String?
  side          String   // buy, sell
  type          String   // market, limit, stop_limit
  status        String   // open, filled, cancelled, expired
  quantity      Float
  price         Float?
  stopPrice     Float?
  filledQty     Float    @default(0)
  avgPrice      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([exchange, orderId])
  @@index([exchange, symbol])
  @@index([status])
}

// Portfolio snapshots for historical tracking
model PortfolioSnapshot {
  id            String   @id @default(cuid())
  totalValueUSD Float
  spotValueUSD  Float
  futuresValueUSD Float
  unrealizedPnL Float
  realizedPnL   Float
  snapshotAt    DateTime @default(now())

  @@index([snapshotAt])
}

// ==================== DASHBOARD MODELS ====================

// User dashboard layout preferences
model UserDashboard {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  layout    Json     // Modül pozisyonları, boyutları, ayarları
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Saved dashboard templates
model DashboardTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json     // { modules, zoom, panX, panY }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// User's favorited dashboard tools
model UserFavorite {
  id          String   @id @default(cuid())
  userId      String
  type        String
  favoritedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ==================== LANDING PAGE MODELS ====================

model EarlyAccess {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  telegram  String?
  message   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email])
}
